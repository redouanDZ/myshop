# ==========================================
# myshop - Environment Configuration Example
# ==========================================

# Server & Application
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecommerce_store
DB_USER=ecommerce_user
DB_PASSWORD=change_this_to_your_own_strong_password

# Store White-Label Branding Settings
STORE_NAME="المتجر الإلكتروني"
STORE_TAGLINE="متجرك الموثوق للتسوق في الجزائر"
STORE_PHONE="0550 00 00 00"
STORE_EMAIL="contact@myshop.dz"
STORE_ADDRESS="الجزائر العاصمة، الجزائر"
STORE_LOGO_URL="/images/logo.png"
CURRENCY_SYMBOL="دج"
CURRENCY_CODE="DZD"

# Email Notifications (SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=notifications@myshop.dz
EMAIL_PASS=your_smtp_password
EMAIL_FROM="المتجر الإلكتروني <notifications@myshop.dz>"

# Algerian Payment Gateway (Chargily Pay V2)
# Register at https://pay.chargily.com to get your keys
CHARGILY_PUBLIC_KEY=test_pk_xxxxxxxxxxxx
CHARGILY_SECRET_KEY=test_sk_xxxxxxxxxxxx
CHARGILY_MODE=test

# Security & Secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_your_own_generated_secret_never_use_this_example_value
COOKIE_SECRET=replace_with_your_own_generated_secret_never_use_this_example_value
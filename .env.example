# ==========================================
# MYSHOP - Production Environment Configuration Template
# ==========================================
# WARNING: Never commit the real .env file to version control.

NODE_ENV=production
PORT=3000

# Database Configuration (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=myshop_db
DB_USER=myshop_user
DB_PASSWORD=

# Security & Session Secrets (Generate with crypto.randomBytes(64).toString('hex'))
JWT_SECRET=
COOKIE_SECRET=

# Payment Gateway (Chargily Pay V2 - https://pay.chargily.com)
CHARGILY_PUBLIC_KEY=
CHARGILY_SECRET_KEY=
CHARGILY_MODE=test

# Application & CORS
BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Store Branding Settings
STORE_NAME="المتجر الإلكتروني"
STORE_TAGLINE="متجرك الموثوق للتسوق في الجزائر"
STORE_PHONE="0550 00 00 00"
STORE_EMAIL="contact@myshop.dz"
STORE_ADDRESS="الجزائر العاصمة، الجزائر"
CURRENCY_SYMBOL="دج"
CURRENCY_CODE="DZD"

# Email Notifications (SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=